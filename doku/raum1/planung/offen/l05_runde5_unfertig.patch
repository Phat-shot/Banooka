+## Slide-Puffer (`slide_puffer`, nur wenn > 0): Gibt zurück, ob in diesem
+## Bild ein Slide-Druck zählt. Im laufenden Slide merkt er sich einen Druck
+## am Boden in dessen letzten `slide_puffer` Sekunden; der Druck selbst geht
+## unverändert weiter (dort löst er ohnehin nichts aus, in der Luft bleibt
+## er der Bauchplatscher). Im ersten Bild ohne Slide zählt der gemerkte
+## Druck, wenn die Figur am Boden ist und eine Richtung hält – ein Sprung,
+## ein Stolpern oder ein Absturz vom Slide lassen ihn also verfallen.
+func _slide_puffern(neu: bool, am_boden: bool, staerke: float) -> bool:
+	if sliding > 0.0:
+		if neu and am_boden and sliding <= slide_puffer:
+			_slide_gemerkt = true
+		return neu
+	if not _slide_gemerkt:
+		return neu
+	_slide_gemerkt = false
+	return neu or (am_boden and staerke > 0.1)
+
